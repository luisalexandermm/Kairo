# Copia este archivo a ".env" y rellena tus valores (nunca subas .env a GitHub: ya está en .gitignore).
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Supabase → Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave service_role / secret. Tiene acceso total: SOLO en el servidor, nunca en el navegador.
SUPABASE_SERVICE_KEY=sb_secret_TU_CLAVE_COMPLETA

# Secreto para firmar la sesión del panel: un texto largo y aleatorio (mínimo 16 caracteres).
TOKEN_SECRET=

# Avisos automáticos por WhatsApp (opcional, Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+573145312045
