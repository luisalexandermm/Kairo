# Copia este archivo a ".env" y rellena con tus valores de Supabase
# (nunca subas .env a GitHub — ya está en .gitignore)

# URL de tu proyecto Supabase (ej: https://abcdefgh.supabase.co)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave SERVICE_ROLE de Supabase (Settings → API → service_role)
# ⚠️  Esta clave tiene acceso total — nunca la expongas al navegador
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secreto para firmar tokens de sesión del panel (pon cualquier texto largo)
TOKEN_SECRET=kairo-super-secreto-2026-cambiame
