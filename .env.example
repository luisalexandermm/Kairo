# Copia este archivo a ".env" y rellena tus valores (nunca subas .env a GitHub: ya está en .gitignore).
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Supabase → Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave service_role / secret. Tiene acceso total: SOLO en el servidor, nunca en el navegador.
SUPABASE_SERVICE_KEY=sb_secret_TU_CLAVE_COMPLETA

# Secreto para firmar la sesión del panel: un texto largo y aleatorio (mínimo 16 caracteres).
TOKEN_SECRET=

# Avisos automáticos por WhatsApp (opcional, Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+573145312045

# Pasarela de pago Wompi (tarjeta, PSE, Nequi, Bancolombia) — comercios.wompi.co → Desarrolladores
# Si las dos primeras están vacías, la opción "Pago en línea" no aparece en la tienda.
# Llaves de pruebas: pub_test_… / test_integrity_… · Llaves reales: pub_prod_… / prod_integrity_…
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos. En Wompi configura la URL de eventos: https://TU_DOMINIO/api/wompi
WOMPI_EVENTS_SECRET=
# Dirección pública de la tienda (a donde Wompi devuelve al cliente). Ej.: https://puntoclub.vercel.app
SITE_URL=
