{
  "builds": [
    { "src": "api/catalog.js", "use": "@vercel/node" },
    { "src": "api/login.js", "use": "@vercel/node" },
    { "src": "api/orders.js", "use": "@vercel/node" },
    { "src": "api/admin.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/catalog", "dest": "/api/catalog.js" },
    { "src": "/api/login", "dest": "/api/login.js" },
    { "src": "/api/orders", "dest": "/api/orders.js" },
    { "src": "/api/admin", "dest": "/api/admin.js" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,x-admin-token" }
      ]
    }
  ]
}
